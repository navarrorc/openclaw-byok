# Copy to .env and fill in locally if reproducing this compose file outside
# Coolify. In the real product, none of this is a file at all — the
# customer pastes their key straight into Coolify's environment variable
# UI for their own app, and Coolify injects it at container start.

# BYOK credential - the customer's own Gemini API key.
GEMINI_API_KEY=

# Model to use by default (see https://ai.google.dev for available Gemini model ids).
OPENCLAW_PRIMARY_MODEL=google/gemini-2.5-flash

# Auto-generated per-deployment by Coolify; not customer-facing.
AUTH_USERNAME=
AUTH_PASSWORD=
OPENCLAW_GATEWAY_TOKEN=
